<%
  var menu = theme.menu || theme.menus || {};
  var social = theme.social || {};
%>
<header class="site-header fixed left-1/2 top-[max(16px,env(safe-area-inset-top))] z-[4] flex min-h-[74px] w-[min(2120px,calc(100vw-32px))] -translate-x-1/2 items-center justify-between gap-[18px] rounded-[22px] border border-white/15 bg-[rgba(8,16,31,0.42)] px-[18px] py-3 shadow-[0_20px_60px_rgba(2,8,18,0.24)] backdrop-blur-[18px] backdrop-saturate-[1.45] max-[767px]:top-[max(10px,env(safe-area-inset-top))] max-[767px]:min-h-0 max-[767px]:w-[calc(100vw-20px)] max-[767px]:items-start max-[767px]:rounded-[18px] max-[767px]:p-[10px] [.has-qiyu-cursor_&]:![cursor:var(--cursor-normal),auto] [.has-qiyu-cursor_&_*]:![cursor:var(--cursor-normal),auto]">
  <a class="site-brand inline-flex min-w-0 items-center gap-[10px] whitespace-nowrap font-bold text-pearl max-[767px]:max-w-[46vw] max-[767px]:text-sm [.has-qiyu-cursor_&]:cursor-pointer!" href="<%- url_for('/') %>" aria-label="<%- theme.title || config.title || '首页' %>">
    <span class="brand-sigil inline-grid size-[30px] shrink-0 place-items-center rounded-full bg-[linear-gradient(135deg,#ffb7c5,#fff4f8_48%,#d4a574)] text-[#2c1821] shadow-[0_0_24px_rgba(255,183,197,0.54)] max-[767px]:size-7">✦</span>
    <span><%- theme.title || config.title || '深海樱花·祁煜' %></span>
  </a>
  <nav class="nav-menu flex items-center justify-end gap-1.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden max-[767px]:max-w-[52vw] max-[767px]:justify-start" aria-label="主导航">
    <% for (var name in menu) { if (Object.prototype.hasOwnProperty.call(menu, name)) { %>
      <a class="nav-button inline-flex min-h-[38px] shrink-0 cursor-pointer select-none items-center justify-center rounded-2xl border border-pink/25 bg-white/5 px-[14px] py-2 text-sm text-pearl/80 shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] transition-[border-color,background,color,transform] duration-200 hover:-translate-y-px hover:border-pink/40 hover:bg-pink/10 hover:text-pearl focus-visible:-translate-y-px focus-visible:border-pink/40 focus-visible:bg-pink/10 focus-visible:text-pearl focus-visible:outline-none active:translate-y-0 active:border-pink/50 active:bg-pink/20 max-[767px]:px-[10px] max-[767px]:py-[7px] max-[767px]:text-[13px] [.has-qiyu-cursor_&]:cursor-pointer!" href="<%- url_for(menu[name]) %>"><%- name %></a>
    <% }} %>
    <% for (var socialName in social) { if (Object.prototype.hasOwnProperty.call(social, socialName) && social[socialName]) { %>
      <a class="nav-button inline-flex min-h-[38px] shrink-0 cursor-pointer select-none items-center justify-center rounded-2xl border border-pink/25 bg-white/5 px-[14px] py-2 text-sm text-pearl/80 shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] transition-[border-color,background,color,transform] duration-200 hover:-translate-y-px hover:border-pink/40 hover:bg-pink/10 hover:text-pearl focus-visible:-translate-y-px focus-visible:border-pink/40 focus-visible:bg-pink/10 focus-visible:text-pearl focus-visible:outline-none active:translate-y-0 active:border-pink/50 active:bg-pink/20 max-[767px]:px-[10px] max-[767px]:py-[7px] max-[767px]:text-[13px] [.has-qiyu-cursor_&]:cursor-pointer!" href="<%- social[socialName] %>" target="_blank" rel="noopener noreferrer"><%- socialName %></a>
    <% }} %>
  </nav>
</header>
