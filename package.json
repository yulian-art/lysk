{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css && hexo generate",
    "build:css": "tailwindcss -i ./themes/lysk-qiyu/tailwind.css -o ./themes/lysk-qiyu/source/css/theme.css --minify",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "npm run build:css && hexo server",
    "watch:css": "tailwindcss -i ./themes/lysk-qiyu/tailwind.css -o ./themes/lysk-qiyu/source/css/theme.css --watch"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "aplayer": "^1.10.1",
    "hexo": "^8.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3"
  }
}
